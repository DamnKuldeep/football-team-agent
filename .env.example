# Copy to .env to run locally (on Streamlit Cloud, put these in the app's Secrets). Never commit a real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
MODEL=deepseek/deepseek-chat      # or google/gemini-3.8-flash, anthropic/claude-sonnet-5
BUDGET_USD=5.00
BUDGET_MODE=warn                  # "block": no AI calls once the budget is spent
PLAYER_SOURCE=synthetic           # synthetic | kaggle | both
