{
  "_comment": "Maps the Kaggle 'FIFA 22 complete player dataset' (stefanoleone992/fifa-22-complete-player-dataset, players_22.csv) to our attribute schema. Short legacy names (used by tests/fixtures/sample_kaggle.csv) come first; the real dataset's prefixed names come after them, so when a CSV has both, the more specific real column wins. Columns absent from a CSV are skipped.",
  "column_to_attribute": {
    "pace": "pace",
    "movement_sprint_speed": "pace",
    "movement_acceleration": "acceleration",
    "stamina": "stamina",
    "power_stamina": "stamina",
    "short_passing": "passing_short",
    "attacking_short_passing": "passing_short",
    "long_passing": "passing_long",
    "skill_long_passing": "passing_long",
    "vision": "vision",
    "mentality_vision": "vision",
    "crossing": "crossing",
    "attacking_crossing": "crossing",
    "finishing": "finishing",
    "attacking_finishing": "finishing",
    "heading_accuracy": "heading_accuracy",
    "attacking_heading_accuracy": "heading_accuracy",
    "dribbling": "dribbling",
    "skill_dribbling": "dribbling",
    "ball_control": "ball_control",
    "skill_ball_control": "ball_control",
    "composure": "composure",
    "mentality_composure": "composure",
    "aggression": "aggression",
    "mentality_aggression": "aggression",
    "standing_tackle": "tackling_standing",
    "defending_standing_tackle": "tackling_standing",
    "sliding_tackle": "tackling_sliding",
    "defending_sliding_tackle": "tackling_sliding",
    "marking": "marking",
    "defending_marking_awareness": "marking",
    "defending": "positioning",
    "gk_diving": "gk_reflexes",
    "goalkeeping_reflexes": "gk_reflexes",
    "gk_handling": "gk_handling",
    "goalkeeping_handling": "gk_handling",
    "gk_positioning": "gk_positioning",
    "goalkeeping_positioning": "gk_positioning",
    "gk_kicking": "gk_kicking",
    "goalkeeping_kicking": "gk_kicking"
  },
  "derived_attributes": {
    "_comment": "Attributes with no single FIFA column. Computed only when every source column is present, and then they override any direct mapping above.",
    "through_ball": {"mean": ["mentality_vision", "attacking_short_passing"]},
    "pass_power_bullet": {"mean": ["skill_long_passing", "power_shot_power"]},
    "heading_power": {"mean": ["power_jumping", "power_strength"]},
    "positioning": {"max": ["mentality_positioning", "mentality_interceptions"]}
  },
  "identity_columns": {
    "player_id": "sofifa_id",
    "name": "short_name",
    "preferred_foot": "preferred_foot",
    "weak_foot_rating": "weak_foot",
    "age": "age",
    "nationality": "nationality_name",
    "player_positions": "player_positions"
  },
  "no_direct_mapping": [
    "through_ball", "pass_power_bullet", "heading_power"
  ]
}
